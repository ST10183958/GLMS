@model GLMS.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Create Service Request";
}

<div class="container mt-4">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">
            <h3>Create Service Request</h3>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Contract ID
                    </label>

                    <input asp-for="ContractId"
                           class="form-control" />

                    <span asp-validation-for="ContractId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Cost USD
                    </label>

                    <input asp-for="CostUsd"
                           class="form-control" />

                    <span asp-validation-for="CostUsd"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Pending">
                            Pending
                        </option>

                        <option value="Approved">
                            Approved
                        </option>

                        <option value="Rejected">
                            Rejected
                        </option>

                    </select>
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Create Request
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}