@model GLMS.Web.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>GLMS Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            padding: 0;
            background: #f0f2f5;
            font-family: Arial, Helvetica, sans-serif;
            height: 100vh;
            overflow: hidden;
        }

        .main-container {
            display: flex;
            height: 100vh;
        }

        .left-panel {
            flex: 1;
            background: linear-gradient(135deg, #1877f2, #0d47a1);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 80px;
        }

        .left-panel h1 {
            font-size: 60px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .left-panel p {
            font-size: 22px;
            line-height: 1.7;
            max-width: 600px;
        }

        .right-panel {
            width: 500px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            width: 100%;
            max-width: 380px;
        }

        .login-card h2 {
            font-weight: bold;
            margin-bottom: 25px;
            text-align: center;
            color: #1877f2;
        }

        .btn-login {
            background: #1877f2;
            border: none;
            font-weight: bold;
            padding: 12px;
        }

        .btn-login:hover {
            background: #166fe5;
        }

        .register-link {
            text-align: center;
            margin-top: 20px;
        }

        .register-link a {
            text-decoration: none;
            color: #1877f2;
            font-weight: bold;
        }

        .glms-logo {
            font-size: 48px;
            font-weight: bold;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

<div class="main-container">

    <div class="left-panel">

        <div class="glms-logo">
            GLMS
        </div>

        <h1>
            Global Logistics
            Management System
        </h1>

        <p>
            Coordinate international freight contracts,
            service requests, logistics workflows,
            and enterprise shipping operations
            through a scalable cloud-native platform.
        </p>

    </div>

    <div class="right-panel">

        <div class="login-card">

            <h2>Sign In</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <form asp-action="Login" method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Username
                    </label>

                    <input asp-for="Username"
                           class="form-control form-control-lg" />
                </div>

                <div class="mb-4">
                    <label class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control form-control-lg" />
                </div>

                <button type="submit"
                        class="btn btn-primary btn-login w-100">
                    Login
                </button>

            </form>

            <div class="register-link">
                <a asp-action="Register">
                    Create New Account
                </a>
            </div>

        </div>

    </div>

</div>

<partial name="_ValidationScriptsPartial" />

</body>
</html>